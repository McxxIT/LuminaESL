{
  "name": "lumina-esl",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @lumina/frontend",
    "dev:api": "npm run dev --workspace @lumina/backend",
    "build": "npm run build --workspace @lumina/frontend && npm run build --workspace @lumina/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspace @lumina/backend",
    "db:generate": "npm run db:generate --workspace @lumina/backend",
    "db:migrate": "npm run db:migrate --workspace @lumina/backend",
    "db:push": "npm run db:push --workspace @lumina/backend",
    "db:seed": "npm run db:seed --workspace @lumina/backend",
    "db:reset": "npm run db:reset --workspace @lumina/backend",
    "db:studio": "npm run db:studio --workspace @lumina/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
