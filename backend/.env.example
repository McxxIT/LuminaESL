NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lumina

# Must be at least 32 characters
JWT_SECRET=replace-me-with-a-long-random-secret-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Local directory for uploaded files
UPLOAD_DIR=uploads

# Public web origin used to build set-password links (required in production;
# outside production it falls back to the first CORS_ORIGIN entry)
APP_URL=http://localhost:3000

# Minimum seconds between invite resends for the same user (default 30)
INVITE_RESEND_COOLDOWN_SECONDS=30

# Outgoing mail for account invites.
# MAIL_MAILER: smtp (real send) | log (dev: link shown to admins, nothing sent)
# Production requires smtp plus host, from address and encryption.
# Gmail: host smtp.gmail.com, port 587 with MAIL_ENCRYPTION=tls (or 465 with ssl),
# and a 16-character app password (needs 2-Step Verification).
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Lumina ESL"
